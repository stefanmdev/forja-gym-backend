# Copiar este archivo como .env y completar los valores.
# Nunca subir el archivo .env al repositorio.

# --- Base (en uso) ---
PORT=3000
# Vacía = el servidor arranca sin base de datos.
# Ejemplo local: mongodb://localhost:27017/forja_gym
MONGO_URI=
# Orígenes permitidos por CORS, separados por coma (desarrollo y producción)
CORS_ORIGINS=http://localhost:5173

# --- Se completan cuando se desarrolle cada funcionalidad ---
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Correo: las variables se agregan cuando el grupo defina el proveedor
